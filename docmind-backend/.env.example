# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- Neon Postgres ---
# From your Neon project dashboard: Connection Details.
# JDBC form: jdbc:postgresql://<host>/<database>?sslmode=require
DB_URL=jdbc:postgresql://<your-neon-host>/<your-db-name>?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# --- Google Gemini ---
# From Google AI Studio (ai.google.dev) -> Get API key.
GEMINI_API_KEY=

# --- Pinecone ---
# From Pinecone console -> API Keys, and your index's host (Index -> Overview -> Host).
# Index must be created with dimension 768 to match gemini-embedding-001's configured output.
PINECONE_API_KEY=
PINECONE_INDEX_HOST=

# --- JWT ---
# Generate with: openssl rand -base64 64
JWT_SECRET=

# --- Optional ---
SERVER_PORT=8080
JWT_EXPIRATION_MS=86400000
